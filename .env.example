# ============================================
# IVM-Lite 환경 변수 템플릿
# ============================================
# 복사: cp .env.example .env
# 이 파일을 .env로 복사한 뒤 실제 값으로 채우세요.
# .env는 .gitignore에 포함되어 커밋되지 않습니다.

# AWS (DynamoDB Contract Registry)
export AWS_ACCESS_KEY_ID=
export AWS_SECRET_ACCESS_KEY=
export AWS_REGION=ap-northeast-2

# 또는 AWS CLI 프로필 사용 (accessKey보다 우선)
# export AWS_PROFILE=your-profile

# DynamoDB
export DYNAMODB_TABLE=
# export DYNAMODB_ENDPOINT=  # 로컬/LocalStack 시에만

# PostgreSQL (ivmlite DB)
export DB_URL=jdbc:postgresql://localhost:5432/ivmlite
export DB_USER=postgres
export DB_PASSWORD=

# RawData DB (크롤러 연동 시)
# export RAWDATA_PGHOST=
# export RAWDATA_PGPORT=5432
# export RAWDATA_PGUSER=
# export RAWDATA_PGPASSWORD=
# export RAWDATA_PGDATABASE=rawdata

# Kafka (선택)
# export KAFKA_BOOTSTRAP_SERVERS=localhost:9094
