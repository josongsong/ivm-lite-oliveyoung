# =============================================================================
# IVM-Lite .gitignore — Kotlin · React · Python · Infra
# =============================================================================

# -----------------------------------------------------------------------------
# Build & Dependencies
# -----------------------------------------------------------------------------

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Node.js / npm / pnpm / yarn
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.pnp.*
.npmrc.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.env/
*.egg-info/
.eggs/
*.egg

# -----------------------------------------------------------------------------
# IDE & Editors
# -----------------------------------------------------------------------------

# IntelliJ IDEA / JetBrains
.idea/
*.iml
*.iws
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Eclipse
.classpath
.project
.settings/
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# AI / Agent tools (Cursor, Claude, Conductor, Serena)
.cursor/
.claude/
.conductor/
.serena/

# -----------------------------------------------------------------------------
# OS & System
# -----------------------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# -----------------------------------------------------------------------------
# Kotlin / JVM
# -----------------------------------------------------------------------------

*.kt.swp
*.kt~
*.kt.bak
*.kotlin_module
*.class

# -----------------------------------------------------------------------------
# Logs & Runtime
# -----------------------------------------------------------------------------

*.log
logs/
*.log.*
*.pid
*.seed
*.pid.lock

# -----------------------------------------------------------------------------
# Secrets & Local Config
# -----------------------------------------------------------------------------

.env
.env.*
!.env.example
*.local
config/local/
application-local.yml
application-local.properties

# -----------------------------------------------------------------------------
# Test & Coverage
# -----------------------------------------------------------------------------

.nyc_output/
coverage/
*.lcov
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# -----------------------------------------------------------------------------
# Temporary & Cache
# -----------------------------------------------------------------------------

*.tmp
.tmp/
*.temp
*.swp
*.swo
*~
.cache/

# -----------------------------------------------------------------------------
# Package & Artifacts
# -----------------------------------------------------------------------------

*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
dist/
target/

# -----------------------------------------------------------------------------
# Database & Storage
# -----------------------------------------------------------------------------

*.db
*.sqlite
*.sqlite3
.dynamodb/

# -----------------------------------------------------------------------------
# Infra (Terraform, Docker)
# -----------------------------------------------------------------------------

*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfvars
!*.tfvars.example
.terraform/
# .terraform.lock.hcl → 버전 재현성 위해 커밋 (ignore 안 함)
docker-compose.override.yml

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

secrets/
*.pem
*.key
*.crt
*.p12
*.jks

# -----------------------------------------------------------------------------
# Project-specific
# -----------------------------------------------------------------------------

# jOOQ generated (build output)
# src/main/kotlin/**/generated/ 는 jOOQ 코드로 git 관리
!**/src/main/**/generated/
gen/

# DX 도구 출력 (extract-paths, paths-to-impact)
paths.yaml
impact-map-draft.yaml

# _wip: 작업 중 임시 디렉터리
_wip/
