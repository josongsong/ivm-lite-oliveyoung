{
  "config": {
    "default": false,
    "MD001": true,
    "MD025": true,
    "MD047": true
  },
  "globs": [
    "docs/adr/**/*.md",
    "docs/guides/**/*.md",
    "docs/*.md"
  ],
  "ignores": [
    "**/node_modules/**",
    "**/build/**",
    "**/.gradle/**",
    "docs/archive/**",
    "docs/rfc_archive/**",
    "docs/proposals/**"
  ]
}
